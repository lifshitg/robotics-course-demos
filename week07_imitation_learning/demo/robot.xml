<mujoco model="planar_reaching">
  <option timestep="0.01" gravity="0 0 0" integrator="RK4"/>
  <visual><global offwidth="960" offheight="720"/></visual>
  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 .05" rgba=".88 .9 .92 1"/>
    <body name="robot" pos="0 0 .12">
      <joint name="x" type="slide" axis="1 0 0" damping="0"/>
      <joint name="y" type="slide" axis="0 1 0" damping="0"/>
      <geom name="robot_geom" type="cylinder" size=".08 .04" mass="1" rgba=".05 .55 .65 1"/>
    </body>
    <body name="target" mocap="true" pos=".4 .4 .025">
      <geom type="cylinder" size=".06 .01" rgba="1 .55 .05 .8" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="force_x" joint="x" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
    <motor name="force_y" joint="y" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
