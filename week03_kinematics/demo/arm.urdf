<?xml version="1.0"?>
<robot name="planar_arm">
  <!-- world is a fixed anchor, not a movable body. base_link is 0.25 m high. -->
  <link name="world"/>
  <link name="base_link">
    <inertial><mass value="2"/><inertia ixx="0.013333" ixy="0" ixz="0" iyy="0.013333" iyz="0" izz="0.013333"/></inertial>
    <visual><geometry><box size="0.2 0.2 0.2"/></geometry><material name="base_gray"><color rgba="0.35 0.35 0.4 1"/></material></visual>
    <collision><geometry><box size="0.2 0.2 0.2"/></geometry></collision>
  </link>
  <joint name="world_anchor" type="fixed">
    <parent link="world"/><child link="base_link"/><origin xyz="0 0 0.25"/>
  </joint>
  <!-- Each link frame is at its proximal joint; geometry extends along +x. -->
  <link name="link1">
    <inertial><origin xyz="0.3 0 0"/><mass value="1"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0303" iyz="0" izz="0.0303"/></inertial>
    <visual><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.06 0.06"/></geometry><material name="blue"><color rgba="0.1 0.4 0.9 1"/></material></visual>
    <collision><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.06 0.06"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/><axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="20" velocity="1"/>
  </joint>
  <link name="link2">
    <inertial><origin xyz="0.2 0 0"/><mass value="0.7"/><inertia ixx="0.00042" ixy="0" ixz="0" iyy="0.0095433333" iyz="0" izz="0.0095433333"/></inertial>
    <visual><origin xyz="0.2 0 0"/><geometry><box size="0.4 0.06 0.06"/></geometry><material name="orange"><color rgba="1 0.45 0.1 1"/></material></visual>
    <collision><origin xyz="0.2 0 0"/><geometry><box size="0.4 0.06 0.06"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0.6 0 0"/><parent link="link1"/><child link="link2"/><axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="20" velocity="1"/>
  </joint>
  <link name="end_effector">
    <inertial><mass value="0.01"/><inertia ixx="0.0000036" ixy="0" ixz="0" iyy="0.0000036" iyz="0" izz="0.0000036"/></inertial>
    <visual><geometry><sphere radius="0.03"/></geometry><material name="green"><color rgba="0.1 0.8 0.25 1"/></material></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="tool_fixed" type="fixed">
    <origin xyz="0.4 0 0"/><parent link="link2"/><child link="end_effector"/>
  </joint>
  <gazebo>
    <self_collide>false</self_collide>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name><topic>/arm/joint1/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands><cmd_max>1</cmd_max><initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name><topic>/arm/joint2/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands><cmd_max>1</cmd_max><initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>joint1</joint_name><joint_name>joint2</joint_name><topic>/arm/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
